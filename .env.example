# Copy to .env. Every key belongs to the dragoman service — the only container
# that reaches a provider. An alias in config/models.yaml whose prefix has no
# key here fails when it is called, naming the variable.
#
# The four below are the four services in dragoman.yaml. Only the keys for the
# agents actually called need a value; `chancery list` says which alias each
# agent resolves to.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Published port for chancery. Nothing publishes dragoman. This is the value
# nabu-frontend's VITE_LLM_HOST points at.
PORT=8081

# Comma-separated allowed origins. Empty denies every cross-origin request, and
# the frontend is a browser app, so this has to name its dev server.
CORS_ORIGINS=http://localhost:5173

LOG_LEVEL=info
ENV=production

# Caller headers to log and forward as identity. nabu-frontend sends both.
LOG_REQUEST_HEADERS=X-Session-ID,X-Project-ID

# Where compose fetches the two binaries to build them. A git URL is a complete
# build context; a local path works too, which is what to use when developing
# the prompts and the server side by side.
# CHANCERY_REPO=https://github.com/mdijkstra-oss/chancery.git
# DRAGOMAN_REPO=https://github.com/mdijkstra-oss/dragoman.git
